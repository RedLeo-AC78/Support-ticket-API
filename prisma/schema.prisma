generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(150)
  description String       @db.VarChar(5000)
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ownerId     Int?
  owner       User?        @relation(fields: [ownerId], references: [id])
  revision    Int          @default(0)
  ai          TicketAi?

  @@index([ownerId])
}

enum Role {
  USER
  AGENT
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique @db.VarChar(254)
  passwordHash String?
  role         Role            @default(USER)
  status       AccountStatus   @default(INVITED)
  createdAt    DateTime        @default(now())
  tickets      Ticket[]
  sessions     Session[]
  resets       PasswordReset[]
  invitations  Invitation[]
}

model Invitation {
  hash      String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Session {
  id              String         @id @default(uuid())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHash      String         @unique
  accessExpiresAt DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  refreshTokens   RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  hash      String    @id
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime?

  @@index([sessionId])
}

model PasswordReset {
  hash      String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

// Identifiants conservés sans relation cascade : l'historique survit au compte.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int
  targetId   Int
  targetType String   @default("USER") @db.VarChar(20)
  action     String   @db.VarChar(60)
  before     String?  @db.VarChar(30)
  after      String?  @db.VarChar(30)
  createdAt  DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([createdAt])
}

enum AiState {
  PROCESSING
  ANSWERED
  OFF_TOPIC
  NEEDS_REVIEW
  FAILED
  CONFIRMED
}

model TicketAi {
  ticketId       Int      @id
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  state          AiState
  classification String?  @db.VarChar(30)
  answer         String?  @db.VarChar(6000)
  reason         String   @db.VarChar(500)
  provider       String   @db.VarChar(50)
  model          String   @db.VarChar(100)
  promptVersion  String   @db.VarChar(30)
  attemptId      String
  attempts       Int      @default(1)
  ticketRevision Int
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}
