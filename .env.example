DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/support_ticket"
PORT=3000
# Exécuter npm run auth:setup pour ajouter JWT_SECRET dans .env.
MAIL_MODE=local
# Pour envoyer réellement : MAIL_MODE=brevo et remplir les valeurs suivantes.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Support Ticket"

# IA facultative : modèle autorisé par le professeur, compatible Responses + Structured Outputs.
# Ne jamais publier la vraie clé. Les tests n'appellent pas OpenAI.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
